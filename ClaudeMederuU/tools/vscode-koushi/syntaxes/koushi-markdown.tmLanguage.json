{
  "information_for_contributors": [
    "Markdownの```koushiフェンス内へsource.koushiの文法を注入する(編集画面のハイライト用)。",
    "beginやwhileの形はVSCode標準のMarkdownフェンス注入の定跡(mermaid拡張等と同型)。正はデッサン01。"
  ],
  "fileTypes": [],
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#koushi-code-block"
    }
  ],
  "repository": {
    "koushi-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(koushi)(\\s*((\\{[^}]*\\})|(\\S*))?)$)",
      "name": "markup.fenced_code.block.markdown",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        }
      },
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.koushi",
          "patterns": [
            {
              "include": "source.koushi"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "markdown.koushi.codeblock"
}
